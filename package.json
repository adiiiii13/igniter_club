{
  "name": "igniter-club-gmit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/sync-parallax.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "frames:webp:2k": "powershell -ExecutionPolicy Bypass -File scripts/generate-webp-frames.ps1 -Input input.mp4 -OutputDir public/frames_hd -Width 2560 -Height 1440 -Fps 24 -Quality 92",
    "frames:webp:hd": "powershell -ExecutionPolicy Bypass -File scripts/generate-webp-frames.ps1 -Input input.mp4 -OutputDir public/frames_hd -Width 1920 -Height 1080 -Fps 24 -Quality 92",
    "frames:jpg:2k": "ffmpeg -y -i input.mp4 -vf \"fps=24,scale=2560:1440:flags=lanczos\" -q:v 2 public/frames_hd/ezgif-frame-%03d.jpg",
    "frames:jpg:hd": "ffmpeg -y -i input.mp4 -vf \"fps=24,scale=1920:1080:flags=lanczos\" -q:v 2 public/frames_hd/ezgif-frame-%03d.jpg"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.101.1",
    "animejs": "^4.3.6",
    "framer-motion": "^11.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
